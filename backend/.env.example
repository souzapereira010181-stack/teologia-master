# Porta do servidor da API
PORT=4000

# Chave secreta usada para assinar os tokens JWT (troque por um valor aleatório forte)
JWT_SECRET=troque-esta-chave-por-um-segredo-forte

# Tempo de expiração do token
JWT_EXPIRES_IN=7d

# Caminho do arquivo do banco SQLite
DATABASE_PATH=./data/teologia.db

# Origem permitida para CORS (URL do frontend)
CORS_ORIGIN=http://localhost:5173

# URL base do Ollama local. Requer o serviço em execução (comando: ollama serve).
OLLAMA_URL=http://localhost:11434

# Opcional: força um modelo específico (deve estar instalado, ex: ollama pull mistral).
# Se deixado em branco, o backend detecta automaticamente o primeiro modelo
# instalado (via GET /api/tags) e usa esse.
OLLAMA_MODEL=
